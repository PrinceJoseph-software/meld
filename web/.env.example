# Firebase web config (Firebase console > Project settings > Your apps > Web app).
# These values are public identifiers, not secrets; security comes from firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Local development against the emulator (firebase emulators:start): set to "true".
VITE_USE_FIREBASE_EMULATOR=false

# Android App Links: SHA-256 fingerprint(s) of your release signing certificate,
# comma-separated (see docs/RELEASING.md). Used to generate /.well-known/assetlinks.json.
ANDROID_CERT_SHA256=
